---
/**
 * A static, syntax-colored excerpt of a Compio notebook. Lines starting with
 * `# ` are headings, a leading `name:` is a label, and `+ - * / in` are
 * operators. Results are given explicitly so the sample never depends on
 * live exchange rates.
 */
export interface NotebookSampleLine {
  text: string
  result?: string
}

interface Props {
  lines: NotebookSampleLine[]
  label: string
  caption?: string
  class?: string
}

type Token = { text: string, kind?: 'comment' | 'label' | 'operator' }

const { lines, label, caption, class: className } = Astro.props

function tokenize(text: string): Token[] {
  if (text.startsWith('# ')) return [{ text: '# ', kind: 'comment' }, { text: text.slice(2) }]

  const tokens: Token[] = []
  const label = /^[^:]+:/.exec(text)?.[0]
  if (label) tokens.push({ text: label, kind: 'label' })

  for (const part of text.slice(label?.length ?? 0).split(/(\s(?:[-+*/]|in)\s)/)) {
    if (!part) continue
    const operator = /^(\s)(\S+)(\s)$/.exec(part)
    if (operator) tokens.push({ text: operator[1] }, { text: operator[2], kind: 'operator' }, { text: operator[3] })
    else tokens.push({ text: part })
  }

  return tokens
}
---

<figure class:list={['notebook-sample', className]}>
  <div class="notebook-sample__sheet" role="img" aria-label={label}>
    {lines.map((line) => (
      <div class:list={['notebook-sample__line', { 'notebook-sample__line--heading': line.text.startsWith('# ') }]}>
        <span>{tokenize(line.text).map((token) => token.kind
          ? <span class={`notebook-sample__${token.kind}`}>{token.text}</span>
          : token.text)}</span>
        {line.result && <span class="notebook-sample__result">{line.result}</span>}
      </div>
    ))}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  @layer components {
    .notebook-sample { margin: 0; }

    .notebook-sample__sheet {
      display: flex;
      flex-direction: column;
      overflow-x: auto;
      padding: 32px;
      gap: 12px;
      border: 1px solid var(--website-border);
      border-radius: var(--website-radius-lg);
      background: var(--website-background);
      color: var(--website-syntax-base);
      font-family: var(--website-font-mono);
      font-size: 18px;
      line-height: 1.5;
    }

    .notebook-sample__line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      white-space: pre;
    }

    .notebook-sample__line--heading { font-weight: 700; }
    .notebook-sample__comment { color: var(--website-syntax-comment); }
    .notebook-sample__label { color: var(--website-syntax-label); }
    .notebook-sample__operator { color: var(--website-syntax-operator); }

    .notebook-sample__result {
      padding: 2px 10px;
      border-radius: 0.3em;
      background: var(--website-result-background);
      color: var(--website-result-text);
    }

    figcaption {
      margin-top: 12px;
      font-size: 13.6px;
      line-height: 1.4;
    }

    @media (max-width: 520px) {
      .notebook-sample__sheet {
        padding: 20px;
        font-size: 15px;
      }
    }
  }
</style>
