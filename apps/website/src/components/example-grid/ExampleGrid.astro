---
import LiveNotebook from '../live-notebook/LiveNotebook.astro'

export interface ExampleGridItem {
  title: string
  document: string
  label: string
}

interface Props {
  items: ExampleGridItem[]
  /** Show the “Live” top bar on each notebook. Defaults to true. */
  showBar?: boolean
}

const { items, showBar = true } = Astro.props
---

<ul class="example-grid">
  {items.map((item) => (
    <li class="example-grid__item">
      <h3>{item.title}</h3>
      <LiveNotebook document={item.document} label={item.label} showBar={showBar} />
    </li>
  ))}
</ul>

<style>
  @layer components {
    .example-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
      margin: 0;
      padding: 0;
      gap: 48px 32px;
      list-style: none;
    }

    .example-grid__item {
      display: flex;
      flex-direction: column;
      min-width: 0;
      gap: 16px;
    }

    h3 {
      margin: 0;
      font-size: 24px;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
  }
</style>
