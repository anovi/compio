---
interface Props {
  href: string
  size?: 'md' | 'lg'
  tone?: 'accent' | 'inverse'
  class?: string
}

const { href, size = 'md', tone = 'accent', class: className } = Astro.props
---

<a class:list={['button', `button--${size}`, `button--${tone}`, className]} href={href}><slot /></a>

<style>
  @layer components {
    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 20px;
      border-radius: var(--website-radius-pill);
      font-size: 15px;
      font-weight: 500;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 150ms ease, color 150ms ease;
    }

    .button--md { height: 44px; }

    .button--lg {
      height: 56px;
      padding: 0 32px;
      font-size: 18px;
    }

    .button--accent {
      background: var(--website-accent);
      color: var(--brand-color-on-accent-primary);
    }

    .button--accent:hover {
      background: var(--website-accent-hover);
      color: var(--brand-color-on-accent-primary);
    }

    .button--inverse {
      background: var(--website-inverse-action-background);
      color: var(--website-inverse-action-text);
    }

    .button--inverse:hover {
      background: color-mix(in srgb, var(--website-inverse-action-background) 88%, var(--website-inverse-accent));
      color: var(--website-inverse-action-text);
    }

    @media (prefers-reduced-motion: reduce) {
      .button { transition: none; }
    }
  }
</style>
