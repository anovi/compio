---
import Button from './Button.astro'

interface Props {
  href: string
  note?: string
  class?: string
}

const { href, note, class: className } = Astro.props
---

<div class:list={['call-to-action', className]}>
  <Button href={href} size="lg" tone="inverse"><slot /></Button>
  {note && <p>{note}</p>}
</div>

<style>
  @layer components {
    .call-to-action {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    p {
      margin: 0;
      color: var(--website-inverse-text-muted);
      font-size: 14px;
      line-height: 1.4;
    }
  }
</style>
