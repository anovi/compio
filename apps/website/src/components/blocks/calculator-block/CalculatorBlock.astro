---
interface Props {
  document: string
  editorLabel: string
  reverse?: boolean
  class?: string
}

const { document, editorLabel, reverse = false, class: className } = Astro.props
---

<section class:list={['calculator-block', { 'calculator-block--reverse': reverse }, className]}>
  <div class="calculator-block__copy">
    <slot />
  </div>

  <div class="calculator-block__stage">
    <div class="calculator-block__paper" aria-hidden="true"></div>
    <div class="calculator-block__editor" data-compio-example data-document={document} aria-label={editorLabel}></div>
  </div>
</section>

<style>
  @layer components {
    .calculator-block {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(420px, 1.22fr);
      align-items: center;
      gap: clamp(44px, 8vw, 120px);
    }

    .calculator-block--reverse .calculator-block__copy { order: 2; }
    .calculator-block__copy { max-width: 460px; }

    .calculator-block__stage { position: relative; min-width: 0; padding: clamp(16px, 3vw, 30px); }

    .calculator-block__stage::before {
      position: absolute;
      inset: 0;
      border-radius: 28px;
      background: linear-gradient(rgb(255 255 255 / 22%) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 22%) 1px, transparent 1px), var(--website-surface-strong);
      background-size: 28px 28px;
      content: '';
      transform: rotate(-1deg);
    }

    .calculator-block--reverse .calculator-block__stage::before { background-color: var(--website-accent-soft); transform: rotate(1deg); }

    .calculator-block__paper {
      position: absolute;
      inset: 9% 5% 3% 11%;
      border: 1px solid var(--website-divider);
      border-radius: 15px;
      background: var(--website-background);
      box-shadow: var(--brand-shadow-sm);
      transform: rotate(3deg);
    }

    .calculator-block--reverse .calculator-block__paper { transform: rotate(-3deg); }

    .calculator-block__editor {
      position: relative;
      height: 380px;
      overflow: hidden;
      border: 1px solid var(--website-editor-border);
      border-radius: 15px;
      background: var(--brand-color-background);
      box-shadow: var(--brand-shadow-lg);
    }

    @media (max-width: 820px) {
      .calculator-block { grid-template-columns: 1fr; }
      .calculator-block--reverse .calculator-block__copy { order: initial; }
      .calculator-block__copy { max-width: 610px; }
    }

    @media (max-width: 520px) {
      .calculator-block__editor { height: 340px; }
    }
  }
</style>
