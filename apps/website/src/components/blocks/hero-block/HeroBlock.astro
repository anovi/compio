---
import { Sunlight } from '../../sunlight'

interface Props {
  id?: string
  videoId: string
  videoSrc: string
  videoLabel: string
  class?: string
}

const { id, videoId, videoSrc, videoLabel, class: className } = Astro.props
---

<section class:list={['hero-block', className]} id={id}>
  <Sunlight />

  <div class="site-container hero-block__body">
    <div class="hero-block__copy">
      <slot />
    </div>

    <figure class="hero-block__media" id={videoId} data-hero-video>
      <video
        aria-label={videoLabel}
        loop
        muted
        playsinline
        preload="auto"
        src={videoSrc}
      ></video>
      <button class="hero-block__toggle" type="button" aria-label="Play video" data-hero-video-toggle hidden>
        <svg class="hero-block__icon-pause" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 4v10M12 4v10"></path>
        </svg>
        <svg class="hero-block__icon-play" width="18" height="18" viewBox="0 0 18 18" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 4l8 5-8 5z"></path>
        </svg>
      </button>
    </figure>
  </div>
</section>

<style>
  @layer components {
    .hero-block {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      /* Leave room for the sticky header that overlaps the hero. */
      padding-top: var(--website-header-height);
      background: var(--website-inverse-background);
      color: var(--website-inverse-text);
    }

    .hero-block__body {
      position: relative;
      display: grid;
      padding: 48px 0 96px;
      gap: 48px;
    }

    .hero-block__copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
      min-width: 0;
    }

    .hero-block__media {
      position: relative;
      width: 100%;
      margin: 0;
    }

    video {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      background: var(--website-inverse-background);
    }

    .hero-block__toggle {
      position: absolute;
      right: 16px;
      bottom: 16px;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      padding: 0;
      border: 0;
      border-radius: var(--website-radius-pill);
      background: var(--website-inverse-control);
      color: var(--website-inverse-text);
      cursor: pointer;
    }

    .hero-block__toggle[hidden] { display: none; }
    .hero-block__toggle[data-playing] .hero-block__icon-play,
    .hero-block__toggle:not([data-playing]) .hero-block__icon-pause { display: none; }

    /* On wide screens the video fills the hero's height beside the copy. */
    @media (min-width: 1200px) {
      .hero-block__copy { max-width: 540px; }

      .hero-block__media {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: auto;
        aspect-ratio: 1;
      }

      video {
        position: absolute;
        inset: 0;
        height: 100%;
      }
    }
  }
</style>

<script>
  import { initializeHeroVideos } from './hero-video'

  const cleanupHeroVideos = initializeHeroVideos()
  window.addEventListener('pagehide', (event) => {
    if (!event.persisted) cleanupHeroVideos()
  }, { once: true })
</script>
