---
interface Props {
  videoSrc: string
  videoLabel: string
  class?: string
}

const {
  videoSrc,
  videoLabel,
  class: className,
} = Astro.props
---

<header class:list={['hero-block', className]}>
  <div class="hero-block__copy">
    <slot />
  </div>

  <div class="hero-block__media">
    <div class="hero-block__video-shell">
      <div class="hero-block__video-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>monthly-budget.cpio</p>
      </div>
      <video
        aria-label={videoLabel}
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        src={videoSrc}
      ></video>
    </div>
    <div class="hero-block__result" aria-hidden="true">
      <span>left for the month</span>
      <strong>€2,045</strong>
    </div>
  </div>
</header>

<style>
  @layer components {
    .hero-block {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1.08fr);
      align-items: center;
      gap: clamp(48px, 8vw, 112px);
    }

    .hero-block__copy { max-width: 610px; }

    .hero-block__media {
      position: relative;
      min-width: 0;
      padding: clamp(18px, 3vw, 34px);
    }

    .hero-block__media::before {
      position: absolute;
      inset: 0;
      border-radius: 46% 54% 58% 42% / 38% 42% 58% 62%;
      background: radial-gradient(circle at 68% 24%, rgb(255 255 255 / 45%), transparent 28%), var(--website-accent-soft);
      content: '';
      transform: rotate(-3deg);
    }

    .hero-block__video-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgb(0 0 0 / 12%);
      border-radius: 18px;
      background: #202020;
      box-shadow: 0 30px 80px rgb(49 63 59 / 20%);
      transform: rotate(1.2deg);
    }

    .hero-block__video-bar {
      display: flex;
      align-items: center;
      height: 35px;
      padding: 0 12px;
      gap: 6px;
      border-bottom: 1px solid rgb(255 255 255 / 8%);
      color: #aaa;
      background: #191919;
    }

    .hero-block__video-bar span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #5b5b5b;
    }

    .hero-block__video-bar p {
      margin: 0 0 0 7px;
      font-family: var(--brand-font-mono);
      font-size: 0.64rem;
    }

    video {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
    }

    .hero-block__result {
      position: absolute;
      right: -10px;
      bottom: 2px;
      z-index: 1;
      display: grid;
      min-width: 168px;
      padding: 13px 16px;
      border: 1px solid color-mix(in srgb, var(--website-text-primary) 12%, transparent);
      border-radius: 12px;
      background: color-mix(in srgb, var(--website-background) 92%, transparent);
      box-shadow: var(--brand-shadow-lg);
      backdrop-filter: blur(14px);
      transform: rotate(-2deg);
    }

    .hero-block__result span {
      color: var(--website-text-secondary);
      font-size: 0.68rem;
      font-weight: 650;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero-block__result strong { font-size: 1.35rem; letter-spacing: -0.04em; }

    @media (max-width: 820px) {
      .hero-block { grid-template-columns: 1fr; }
      .hero-block__copy { text-align: center; justify-self: center; }
      .hero-block__media { width: min(100%, 610px); justify-self: center; }
    }

    @media (max-width: 520px) {
      .hero-block__result { right: 0; }
    }

  }
</style>
