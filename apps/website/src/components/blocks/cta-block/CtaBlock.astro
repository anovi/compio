---
import Eyebrow from '../../ui/Eyebrow.astro'

interface Props {
  id: string
  eyebrow: string
  title: string
  class?: string
}

const { id, eyebrow, title, class: className } = Astro.props
---

<section class:list={['cta-block', className]} id={id} aria-labelledby={`${id}-title`}>
  <div class="site-container cta-block__inner">
    <div class="cta-block__copy">
      <Eyebrow tone="inverse">{eyebrow}</Eyebrow>
      <h2 id={`${id}-title`}>{title}</h2>
      <slot />
    </div>
    <div class="cta-block__media"><slot name="media" /></div>
  </div>
</section>

<style>
  @layer components {
    .cta-block {
      background: var(--website-inverse-background);
      color: var(--website-inverse-text-secondary);
    }

    .cta-block__inner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
      align-items: center;
      padding: 128px 0 144px;
      gap: 56px 80px;
    }

    .cta-block__copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      max-width: 580px;
      gap: 24px;
    }

    h2 {
      margin: 0;
      color: var(--website-inverse-text);
      font-size: clamp(40px, 5vw, 64px);
      font-weight: 600;
      line-height: 1.02;
      letter-spacing: -0.02em;
    }

    .cta-block__media { min-width: 0; }

    @media (max-width: 767px) {
      .cta-block__inner { padding: 80px 0 96px; }
    }
  }
</style>
