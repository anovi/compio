---
import Eyebrow from '../../ui/Eyebrow.astro'

interface Props {
  id: string
  eyebrow?: string
  title: string
  class?: string
}

const { id, eyebrow, title, class: className } = Astro.props
---

<section class:list={['feature-block', className]} id={id} aria-labelledby={`${id}-title`}>
  <div class="site-container feature-block__inner">
    <div class="feature-block__header">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2 id={`${id}-title`}>{title}</h2>
    </div>
    <slot />
  </div>
</section>

<style>
  @layer components {
    .feature-block__inner {
      display: flex;
      flex-direction: column;
      padding: 128px 0;
      gap: 96px;
    }

    .feature-block__header {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    h2 {
      margin: 0;
      font-size: clamp(40px, 5vw, 64px);
      font-weight: 600;
      line-height: 1.02;
      letter-spacing: -0.02em;
    }

    @media (max-width: 767px) {
      .feature-block__inner {
        padding: 80px 0;
        gap: 64px;
      }
    }
  }
</style>
