---
interface Props {
  imageSrc: string
  imageAlt: string
  reverse?: boolean
  class?: string
}

const { imageSrc, imageAlt, reverse = false, class: className } = Astro.props
---

<section class:list={['image-block', { 'image-block--reverse': reverse }, className]}>
  <div class="image-block__copy">
    <slot />
  </div>

  <div class="image-block__media">
    <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
  </div>
</section>

<style>
  @layer components {
    .image-block {
      display: grid;
      grid-template-columns: minmax(0, 0.82fr) minmax(420px, 1.18fr);
      align-items: center;
      gap: clamp(44px, 8vw, 120px);
    }

    .image-block--reverse .image-block__copy { order: 2; }
    .image-block__copy { max-width: 460px; }

    .image-block__media {
      position: relative;
      min-width: 0;
      overflow: hidden;
      border-radius: 28px;
      background: var(--website-highlight-soft);
    }

    .image-block__media::after {
      position: absolute;
      right: 8%;
      bottom: 7%;
      width: 82px;
      height: 82px;
      border: 1px solid color-mix(in srgb, var(--website-text-primary) 18%, transparent);
      border-radius: 50%;
      content: '';
    }

    img { position: relative; z-index: 1; display: block; width: 100%; height: auto; }

    @media (max-width: 820px) {
      .image-block { grid-template-columns: 1fr; }
      .image-block--reverse .image-block__copy { order: initial; }
      .image-block__copy { max-width: 610px; }
    }
  }
</style>
