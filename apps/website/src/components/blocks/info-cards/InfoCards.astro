---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<section class:list={['info-cards', className]}>
  <div class="site-container info-cards__grid">
    <slot />
  </div>
</section>

<style>
  @layer components {
    .info-cards__grid {
      display: flex;
      flex-direction: column;
      padding: 48px 0;
      gap: 24px;
    }

    /* Keep every card on a single row from tablet width up. */
    @media (min-width: 768px) {
      .info-cards__grid { flex-direction: row; }
    }
  }
</style>
