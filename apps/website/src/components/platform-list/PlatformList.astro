---
/** A row of supported platforms, each shown as a logo with its name. */
import AndroidIcon from '../../assets/icons/platform-android.svg'
import AppleIcon from '../../assets/icons/platform-apple.svg'
import LinuxIcon from '../../assets/icons/platform-linux.svg'
import WindowsIcon from '../../assets/icons/platform-windows.svg'

const platforms = [
  { name: 'Windows', Icon: WindowsIcon },
  { name: 'macOS', Icon: AppleIcon },
  { name: 'Linux', Icon: LinuxIcon },
  { name: 'Android', Icon: AndroidIcon },
  { name: 'iOS', Icon: AppleIcon },
]
---

<ul class="platform-list">
  {platforms.map(({ name, Icon }) => (
    <li class="platform-list__item">
      <Icon aria-hidden="true" />
      <span>{name}</span>
    </li>
  ))}
</ul>

<style>
  @layer components {
    .platform-list {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      gap: 12px 24px;
      list-style: none;
    }

    .platform-list__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      color: var(--website-text-secondary);
      font-size: 13px;
      line-height: 1.3;
    }

    .platform-list__item > :global(svg) {
      display: block;
      width: 36px;
      height: 36px;
      color: var(--website-icon);
    }

    @media (max-width: 520px) {
      .platform-list { gap: 12px 18px; }

      .platform-list__item > :global(svg) {
        width: 30px;
        height: 30px;
      }
    }
  }
</style>
