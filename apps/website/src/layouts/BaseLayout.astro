---
import '@fontsource-variable/figtree/wght.css'
import '../styles/global.css'
import SiteFooter from '../components/site-footer/SiteFooter.astro'
import * as SiteHeader from '../components/site-header'
import Button from '../components/ui/Button.astro'
import { APP_URL } from '../site'

interface Props {
  title: string
  description: string
  mainClass?: string
  /**
   * `landing` leaves the header and page width to the page itself, so its
   * first section can carry the navigation and span the full viewport width.
   */
  variant?: 'page' | 'landing'
}

const { title, description, mainClass, variant = 'page' } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Fix the cascade layer order before any bundled stylesheet can declare a layer first. -->
    <style is:inline>@layer theme, base, components, utilities;</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light'
    </script>
  </head>
  <body>
    {variant === 'page' && (
      <SiteHeader.Root>
        <SiteHeader.Link href="/docs" current={currentPath === '/docs'}>User manual</SiteHeader.Link>
        <SiteHeader.Link href="/prices" current={currentPath === '/prices'}>Prices</SiteHeader.Link>
        <Button href={APP_URL}>Open Compio</Button>
      </SiteHeader.Root>
    )}
    <main class:list={[{ 'site-container': variant === 'page' }, mainClass]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
