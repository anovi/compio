---
import demoVideo from '../assets/compio-demo.mp4'
import DevicesIcon from '../assets/icons/devices.svg'
import OfflineIcon from '../assets/icons/offline.svg'
import * as CtaBlock from '../components/blocks/cta-block'
import * as FeatureBlock from '../components/blocks/feature-block'
import * as HeroBlock from '../components/blocks/hero-block'
import * as InfoCards from '../components/blocks/info-cards'
import NotebookSample, { type NotebookSampleLine } from '../components/notebook-sample/NotebookSample.astro'
import SavedList, { type SavedListItem } from '../components/saved-list/SavedList.astro'
import * as SiteHeader from '../components/site-header'
import Button from '../components/ui/Button.astro'
import CallToAction from '../components/ui/CallToAction.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { APP_URL } from '../site'

const chapters: HeroBlock.Chapter[] = [
  { title: 'Math that keeps up', start: 0 },
  { title: 'Reuse saved calculations', start: 12.4 },
  { title: 'Currencies and unit conversion', start: 24.8 },
  { title: 'Works offline, on every device', start: 40.8 },
]

const currencySample: NotebookSampleLine[] = [
  { text: '# Weekend in Belgrade' },
  { text: 'train: 49 EUR' },
  { text: 'hostel: 2 * 3 200 RSD', result: '6 400 RSD' },
  { text: 'dinner: 85 USD' },
  { text: 'total: train + hostel + dinner in EUR', result: '182.2 EUR' },
]

const unitSample: NotebookSampleLine[] = [
  { text: '10 km in mi', result: '6.21 mi' },
  { text: '2 kg in lb', result: '4.41 lb' },
  { text: '100 cm + 1 m', result: '2 m' },
]

const savedCalculations: SavedListItem[] = [
  { title: 'Monthly budget', edited: 'Edited 2 min ago', selected: true },
  { title: 'Weekend in Belgrade', edited: 'Yesterday' },
  { title: 'Freelance invoice — October', edited: '3 days ago' },
  { title: 'Pancakes for six', edited: 'Last week' },
]
---

<BaseLayout
  title="Compio — a calculator that works like a notebook"
  description="Work through everyday calculations step by step. Convert currencies and units, and save useful calculations for later. No account required, works offline."
  variant="landing"
>
  <HeroBlock.Root
    videoId="hero-video"
    videoSrc={demoVideo}
    videoLabel="Compio demo: calculations, saved notebooks, currencies and units, offline"
  >
    <SiteHeader.Root slot="header" tone="inverse">
      <SiteHeader.Link href="#units">Units &amp; currencies</SiteHeader.Link>
      <SiteHeader.Link href="#offline">Offline</SiteHeader.Link>
      <Button href="#get" tone="inverse">Get Compio</Button>
    </SiteHeader.Root>

    <HeroBlock.Title>A calculator that works like a notebook.</HeroBlock.Title>
    <HeroBlock.Chapters videoId="hero-video" chapters={chapters} />
    <CallToAction href={APP_URL} note="No account required. Works offline.">Open the app</CallToAction>
  </HeroBlock.Root>

  <InfoCards.Root>
    <InfoCards.Card title="On your computer and your phone">
      Install Compio and use it like a regular app.
      <DevicesIcon slot="icon" aria-hidden="true" />
    </InfoCards.Card>
    <InfoCards.Card id="offline" title="Works offline">
      Your notebooks and previously fetched exchange rates stay available without a connection.
      <OfflineIcon slot="icon" aria-hidden="true" />
    </InfoCards.Card>
  </InfoCards.Root>

  <FeatureBlock.Root id="units" eyebrow="Units & currencies" title="Convert without breaking your train of thought">
    <FeatureBlock.Row>
      <FeatureBlock.Title>Currencies</FeatureBlock.Title>
      <FeatureBlock.Lead>Planning a trip abroad? Splitting expenses with friends? Managing money across countries?</FeatureBlock.Lead>
      <FeatureBlock.Description>Add amounts in different currencies in the same calculation. Compio converts them automatically using the latest available exchange rates.</FeatureBlock.Description>
      <NotebookSample
        slot="media"
        lines={currencySample}
        label="A Compio notebook adding a train ticket in euros, a hostel in dinars and a dinner in dollars, totalled in euros"
        caption="Example rates."
      />
    </FeatureBlock.Row>

    <FeatureBlock.Row reverse>
      <FeatureBlock.Title>Units</FeatureBlock.Title>
      <FeatureBlock.Lead>Convert distances, weights, volumes, time, and more, without switching to another tool.</FeatureBlock.Lead>
      <FeatureBlock.Description>Mix compatible units in a calculation or convert a result into the unit you need.</FeatureBlock.Description>
      <NotebookSample
        slot="media"
        lines={unitSample}
        label="Compio converting kilometres to miles and kilograms to pounds, and adding centimetres to metres"
      />
    </FeatureBlock.Row>
  </FeatureBlock.Root>

  <CtaBlock.Root id="get" eyebrow="Saved calculations" title="Your calculations are always at hand">
    <CtaBlock.Description>Save the calculations you come back to—budgets, trip plans, invoices, recipes—and reuse the whole setup instead of rebuilding it from scratch.</CtaBlock.Description>
    <CallToAction class="pt-4" href={APP_URL} note="No account required.">Open Compio &amp; Install</CallToAction>
    <SavedList slot="media" title="Saved calculations" items={savedCalculations} />
  </CtaBlock.Root>
</BaseLayout>
