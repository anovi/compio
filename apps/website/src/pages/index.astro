---
import demoVideo from '../assets/compio-demo.mp4'
import desktopScreenshot from '../assets/compio-desktop-screenshot-02.png'
import OfflineIcon from '../assets/icons/offline.svg'
import * as CtaBlock from '../components/blocks/cta-block'
import * as FeatureBlock from '../components/blocks/feature-block'
import * as HeroBlock from '../components/blocks/hero-block'
import * as InfoCards from '../components/blocks/info-cards'
import AppScreenshot from '../components/app-screenshot/AppScreenshot.astro'
import ExampleGrid, { type ExampleGridItem } from '../components/example-grid/ExampleGrid.astro'
import LiveNotebook from '../components/live-notebook/LiveNotebook.astro'
import PlatformList from '../components/platform-list/PlatformList.astro'
import SavedList, { type SavedListItem } from '../components/saved-list/SavedList.astro'
import Button from '../components/ui/Button.astro'
import CallToAction from '../components/ui/CallToAction.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { APP_URL } from '../site'

const chapters: HeroBlock.Chapter[] = [
  { title: 'Math that keeps up', start: 0 },
  { title: 'Reuse saved calculations', start: 12.4 },
  { title: 'Currencies and unit conversion', start: 24.8 },
  { title: 'Works offline, on every device', start: 40.8 },
]

const currencyExample = `# Weekend in Belgrade
train = 49 EUR
hostel = 2 * 3_200 RSD
dinner = 85 USD
total() in EUR`

const conversionExample = `# Weekend ride
distance = 420 km
fuel used = 28.5 L
fuel price = 1.72 EUR
cost = fuel price * fuel used

distance in mile
fuel used in gal
cost in USD`

const billExample = `# Dinner with friends
pizzas = 3 * 14.50 EUR
drinks = 6 * 4.20 EUR
dessert = 2 * 7 EUR
bill = sum()
tip = bill * 10%
per person = (bill + tip) / 4`

const recipeExample = `# Pancakes for six
servings = 6
scale = servings / 4
flour = 250 g * scale
milk = 500 ml * scale
eggs = ceil(2 * scale)`

const quickExamples: ExampleGridItem[] = [
  {
    title: 'Cooking',
    document: `turkey = 4.5 kg
roast = turkey / 1 kg * 40 min
roast in h`,
    label: 'Interactive Compio notebook working out the roasting time for a 4.5 kg turkey',
  },
  {
    title: 'Running',
    document: `marathon = 42.195 km
half = marathon / 2
half in mile`,
    label: 'Interactive Compio notebook converting a half marathon to miles',
  },
  {
    title: 'Trip',
    document: `hotel = 3 * 95 EUR
flights = 240 USD
total() in EUR`,
    label: 'Interactive Compio notebook totalling a hotel in euros and flights in dollars',
  },
  {
    title: 'Cars',
    document: `trip = 350 km
fuel = trip / 100 km * 6.5 L
cost = fuel / 1 L * 1.72 EUR`,
    label: 'Interactive Compio notebook estimating fuel and its cost for a 350 km drive',
  },
  {
    title: 'Taxes',
    document: `salary = 4_200 EUR
tax = salary * 21%
net = salary - tax`,
    label: 'Interactive Compio notebook taking 21% tax off a monthly salary',
  },
  {
    title: 'Shopping',
    document: `jacket = 120 USD
sale = jacket - 30%`,
    label: 'Interactive Compio notebook applying a 30% discount to a jacket',
  },
]

const savedCalculations: SavedListItem[] = [
  { title: 'Monthly budget', edited: 'Edited 2 min ago', selected: true },
  { title: 'Weekend in Belgrade', edited: 'Yesterday' },
  { title: 'Freelance invoice — October', edited: '3 days ago' },
  { title: 'Pancakes for six', edited: 'Last week' },
]
---

<BaseLayout
  title="Compio — a calculator that works like a notebook"
  description="Work through everyday calculations step by step. Convert currencies and units, and save useful calculations for later. No account required, works offline."
  variant="landing"
  headerInverseOver="hero"
>
  <HeroBlock.Root
    id="hero"
    videoId="hero-video"
    videoSrc={demoVideo}
    videoLabel="Compio demo: calculations, saved notebooks, currencies and units, offline"
  >
    <HeroBlock.Title>A calculator that works like a notebook.</HeroBlock.Title>
    <HeroBlock.Chapters videoId="hero-video" chapters={chapters} />
    <CallToAction href={APP_URL} note="No account required. Works offline.">Open the app</CallToAction>
  </HeroBlock.Root>

  <InfoCards.Root>
    <InfoCards.Card title="On your computer and your phone" wide>
      Install Compio and use it like a regular app.
      <PlatformList slot="icon" />
    </InfoCards.Card>
    <InfoCards.Card id="offline" title="Works offline">
      Your notebooks and previously fetched exchange rates stay available without a connection.
      <OfflineIcon slot="icon" aria-hidden="true" />
    </InfoCards.Card>
  </InfoCards.Root>

  <!-- <FeatureBlock.Root id="desktop" eyebrow="Desktop" title="Plenty of room on a big screen">
    <AppScreenshot
      src={desktopScreenshot}
      alt="Compio desktop app with a trip planning notebook: daily hotel, food and transit costs multiplied by 14 days and totalled in euros"
    />
  </FeatureBlock.Root> -->

  <FeatureBlock.Root id="units" eyebrow="Units & currencies" title="Convert without breaking your train of thought">
    <FeatureBlock.Grid>
      <FeatureBlock.Item>
        <FeatureBlock.Title>Currencies</FeatureBlock.Title>
        <FeatureBlock.Lead>Plan a trip abroad and count in several currencies at once. Compio converts them using the latest exchange rates.</FeatureBlock.Lead>
        <LiveNotebook
          slot="media"
          document={currencyExample}
          label="Interactive Compio notebook adding a train ticket in euros, a hostel in dinars and a dinner in dollars, totalled in euros"
        />
      </FeatureBlock.Item>

      <FeatureBlock.Item>
        <FeatureBlock.Title>Units</FeatureBlock.Title>
        <FeatureBlock.Lead>Mix kilometres, litres, kilograms and more, then write “in” to get the unit you need.</FeatureBlock.Lead>
        <LiveNotebook
          slot="media"
          document={conversionExample}
          label="Interactive Compio notebook converting a ride's distance to miles, fuel to gallons and its cost to dollars"
        />
      </FeatureBlock.Item>
    </FeatureBlock.Grid>
  </FeatureBlock.Root>

  <FeatureBlock.Root id="everyday" eyebrow="Everyday math" title="Write it down the way you think it">
    <FeatureBlock.Grid>
      <FeatureBlock.Item>
        <FeatureBlock.Title>Split the bill</FeatureBlock.Title>
        <FeatureBlock.Lead>List what you ordered, total it with sum(), add a tip and divide by the number of people.</FeatureBlock.Lead>
        <LiveNotebook
          slot="media"
          document={billExample}
          label="Interactive Compio notebook totalling a dinner bill, adding a 10% tip and splitting it between four people"
        />
      </FeatureBlock.Item>

      <FeatureBlock.Item>
        <FeatureBlock.Title>Scale a recipe</FeatureBlock.Title>
        <FeatureBlock.Lead>Change the number of servings once and every ingredient follows.</FeatureBlock.Lead>
        <LiveNotebook
          slot="media"
          document={recipeExample}
          label="Interactive Compio notebook scaling a pancake recipe from four to six servings"
        />
      </FeatureBlock.Item>
    </FeatureBlock.Grid>

    <FeatureBlock.Actions>
      <Button href="/docs" size="lg">Explore all features</Button>
    </FeatureBlock.Actions>
  </FeatureBlock.Root>

  <FeatureBlock.Root id="examples" title="A few lines for everyday questions">
    <ExampleGrid items={quickExamples} />
  </FeatureBlock.Root>

  <CtaBlock.Root id="get" eyebrow="Saved calculations" title="Your calculations are always at hand">
    <CtaBlock.Description>Save the calculations you come back to—budgets, trip plans, invoices, recipes—and reuse the whole setup instead of rebuilding it from scratch.</CtaBlock.Description>
    <CallToAction class="pt-4" href={APP_URL} note="No account required.">Open Compio &amp; Install</CallToAction>
    <SavedList slot="media" title="Saved calculations" items={savedCalculations} />
  </CtaBlock.Root>
</BaseLayout>
