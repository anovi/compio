    "@codemirror/view": "^6.42.1",
    "codemirror": "6.0.2",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.41.0",
    "vite-plugin-pwa": "1.3.0",
    "wrangler": "^4.101.0"
  }
}